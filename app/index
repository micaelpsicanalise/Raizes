        <h3>Guias e orixás</h3>
        <div class="icon-btn" onclick="onOpenSearch()">⌕</div>
      </div>

      <div class="filters" id="tradicao-filters" style="margin-bottom:8px;">
        <!-- setBibliotecaTradicao() troca a tradição ativa e re-renderiza tudo -->
      </div>

      <div class="filters" id="biblioteca-filters">
        <!-- setBibliotecaCategoria() re-renderiza #biblioteca-list a partir de appState.guias/conteudos -->
        <div class="filter active" data-cat="orixas" onclick="setBibliotecaCategoria('orixas', this)">Orixás</div>
        <div class="filter" data-cat="entidades" onclick="setBibliotecaCategoria('entidades', this)">Entidades</div>
