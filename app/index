          <div class="meta"><p class="title">Vovó Cambinda</p><p class="sub">3 pontos · 1 oração</p></div>
          <span class="chev">›</span>
        </div>
        <div class="list-item" onclick="onOpenGuia('iemanja')">
          <div class="dot">I</div>
          <div class="meta"><p class="title">Iemanjá</p><p class="sub">6 pontos · 2 orações</p></div>
          <span class="chev">›</span>
        </div>
      </div>
    </section>

    <!-- ================= HISTÓRIA (povos originários) ================= -->
