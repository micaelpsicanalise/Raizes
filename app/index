          </div>
        </div>
      </div>

      <p class="section-label">Sugestão de hoje</p>
      <div id="home-suggestions" class="list-grid">
        <!-- Conteúdo abaixo é só placeholder visual — renderHomeSuggestions()
             substitui isso assim que os dados reais chegam do Supabase -->
        <div class="list-item" onclick="onOpenTrack('saudacao-ogum')">
          <div class="dot">▶</div>
