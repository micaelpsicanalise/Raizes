<style>
  :root{
    --bg: #F6F2E9;
    --ink: #2B2118;
    --ink-soft: #6B5D4F;
    --terra: #A15C32;
    --terra-dark: #5C3620;
    --gold: #B98A2C;
    --gold-soft: #EADFC4;
    --line: rgba(30,42,32,0.14);
    --card: #FFFFFF;
    --radius: 18px;
    --content-width: 1040px;
  }
  *{box-sizing:border-box;}
  html{ background: var(--bg); }
  body{
    margin:0;
    background: var(--bg);
    font-family:'Inter', sans-serif;
    color: var(--ink);
    min-height:100vh;
    min-height:100dvh;
  }
  a{ color:inherit; }

  /* ---------------- NAV (topo, sempre visível, site normal) ---------------- */
  .site-nav{
    display:flex; align-items:center; justify-content:space-between;
    max-width: var(--content-width); margin:0 auto;
    padding:20px 24px;
    border-bottom:1px solid var(--line);
  }
  .site-nav.hidden{ display:none; }
  .brand{
    font-family:'Fraunces', serif; font-size:19px; font-weight:500; color:var(--ink);
    display:flex; align-items:center; gap:8px;
  }
  .brand .mark{ width:9px; height:9px; border-radius:50%; background:var(--gold); display:inline-block; }
  .nav-links{ display:flex; gap:28px; align-items:center; }
  .nav-link{
    background:none; border:none; font-family:'Inter', sans-serif; font-size:13.5px;
    color:var(--ink-soft); cursor:pointer; padding:4px 0; position:relative;
  }
  .nav-link.active{ color:var(--ink); font-weight:600; }
  .nav-link.active::after{
    content:""; position:absolute; left:0; right:0; bottom:-6px; height:2px; background:var(--gold);
  }

  /* ---------------- MAIN ---------------- */
  .site-main{ max-width: var(--content-width); margin:0 auto; padding:0 24px 80px; }
  .view{ display:none; flex-direction:column; padding-top:36px; }
  .view.active{ display:flex; }

  h1,h2,h3{ font-family:'Fraunces', serif; font-weight:500; margin:0; color:var(--ink); }
  p{ margin:0; }
  .eyebrow{
    font-size:11px; letter-spacing:0.06em; text-transform:uppercase;
    color: var(--ink-soft); font-weight:500;
  }

  .top-row{ display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:24px; gap:16px; }
  .greeting{ font-size:22px; font-family:'Fraunces', serif; }
  .icon-btn{
    width:36px; height:36px; border-radius:50%; background:var(--card);
    border:1px solid var(--line); display:flex; align-items:center; justify-content:center;
    color:var(--ink-soft); font-size:15px; cursor:pointer; flex-shrink:0;
  }

  /* ---------------- HOME hero ---------------- */
  .home-hero{ display:flex; gap:16px; align-items:stretch; margin-bottom:32px; flex-wrap:wrap; }
  .guia-card{
    background: var(--terra); color:#fff; border-radius: var(--radius);
    padding:28px; position:relative; overflow:hidden; flex:2 1 320px;
  }
  .guia-card .eyebrow{ color: var(--gold-soft); }
  .guia-card h2{ color:#fff; font-size:30px; margin-top:8px; }
  .guia-card .sub{ font-size:13px; color:#E4D6C5; margin-top:6px; }
  .ring{
    position:absolute; right:-30px; top:-30px; width:120px; height:120px;
    border-radius:50%; border:1px solid rgba(255,255,255,0.18);
  }
  .ring.small{ right:-10px; top:-10px; width:70px; height:70px; }

  .stat-row{ display:flex; flex-direction:column; gap:10px; flex:1 1 160px; }
  .stat{
    flex:1; background:var(--card); border:1px solid var(--line);
    border-radius:14px; padding:16px; display:flex; align-items:center; justify-content:space-between;
  }
  .stat .num{ font-family:'Fraunces', serif; font-size:26px; }
  .stat .label{ font-size:11.5px; color:var(--ink-soft); text-align:right; }

  .section-label{ font-size:12.5px; color:var(--ink-soft); margin-bottom:12px; text-transform:uppercase; letter-spacing:0.04em; }

  /* ---------------- Listas em grade — nada de coluna única forçada ---------------- */
  .list-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:12px; }
  .list-item{
    display:flex; align-items:center; gap:12px; background:var(--card);
    border:1px solid var(--line); border-radius:14px; padding:14px 16px;
    cursor:pointer; transition:border-color .15s ease;
  }
  .list-item:hover{ border-color:var(--terra); }
  .list-item .dot{
    width:38px; height:38px; border-radius:50%; background: var(--gold-soft);
    flex-shrink:0; display:flex; align-items:center; justify-content:center;
    color: var(--gold); font-size:14px; font-family:'Fraunces', serif; overflow:hidden;
  }
  .list-item .meta{ flex:1; min-width:0; }
  .list-item .title{ font-size:14px; font-weight:500; }
  .list-item .sub{ font-size:11.5px; color:var(--ink-soft); margin-top:2px; }
  .list-item .chev{ color:var(--ink-soft); font-size:14px; flex-shrink:0; }

  .filters{ display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap; }
  .filter{
    font-size:12px; padding:7px 14px; border-radius:20px; white-space:nowrap;
    border:1px solid var(--line); color:var(--ink-soft); cursor:pointer;
  }
  .filter.active{ background:var(--terra); border-color:var(--terra); color:#fff; }

  .back-row{ display:flex; align-items:center; gap:6px; margin-bottom:20px; color:var(--ink-soft); font-size:13px; cursor:pointer; }
  .back-row:hover{ color:var(--ink); }

  /* ---------------- Player — bloco focado, mas dentro da página normal ---------------- */
  .player-panel{ max-width:440px; }
  .art{
    width:140px; height:140px; border-radius:20px; background:var(--terra);
    margin-bottom:20px; position:relative; overflow:hidden;
  }
  .art .ring{ border-color: rgba(255,255,255,0.25); }

  .track-title{ font-size:19px; }
  .track-sub{ font-size:13px; color:var(--ink-soft); margin-top:4px; margin-bottom:26px; }

  .waveform{ display:flex; align-items:flex-end; gap:3px; height:40px; margin-bottom:8px; }
  .bar{ flex:1; background:var(--line); border-radius:2px; }
  .bar.played{ background:var(--gold); }

  .time-row{ display:flex; justify-content:space-between; font-size:11px; color:var(--ink-soft); margin-bottom:24px; }

  .controls{ display:flex; align-items:center; gap:26px; margin-bottom:24px; }
  .controls .side{ color:var(--ink-soft); font-size:19px; cursor:pointer; }
  .play-btn{
    width:54px; height:54px; border-radius:50%; background:var(--terra);
    color:#fff; display:flex; align-items:center; justify-content:center;
    font-size:19px; cursor:pointer; border:none;
  }

  .lyric-toggle{
    display:flex; justify-content:space-between; align-items:center;
    border-top:1px solid var(--line); padding:14px 0; font-size:13px; color:var(--ink-soft);
    cursor:pointer;
  }

  /* ---------------- Login ---------------- */
  .login-view{ align-items:flex-start; padding-top:14vh; }
  .login-view .login-box{ max-width:380px; }
  .login-view h1{ font-size:32px; margin-top:8px; }
  .login-view p.desc{ font-size:14px; color:var(--ink-soft); line-height:1.55; margin-top:10px; }
  .google-btn{
    display:flex; align-items:center; justify-content:center; gap:10px;
    background:#fff; border:1px solid var(--line); border-radius:14px;
    padding:14px 20px; font-family:'Inter',sans-serif; font-size:14px; font-weight:600;
    color:var(--ink); cursor:pointer; width:100%; margin-top:26px;
  }
  .login-note{ font-size:11.5px; color:var(--ink-soft); margin-top:14px; }

  /* ---------------- Perfil ---------------- */
  .profile-header{ display:flex; align-items:center; gap:16px; margin-bottom:28px; }
  .avatar-circle{
    width:60px; height:60px; border-radius:50%; background:var(--gold-soft);
    color:var(--gold); font-family:'Fraunces',serif; font-size:22px;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .profile-name{ font-size:18px; }
  .profile-email{ font-size:12.5px; color:var(--ink-soft); margin-top:2px; }
  .signout-btn{
    background:var(--card); border:1px solid var(--line); border-radius:14px;
    padding:13px; text-align:center; font-size:13.5px; color:var(--ink); cursor:pointer;
    margin-top:16px; max-width:200px;
  }
  .signout-btn:hover{ border-color:var(--terra); }

  .empty-note{ font-size:13px; color:var(--ink-soft); padding:14px 0; }
  .letra-box{ font-size:13px; line-height:1.65; color:var(--ink-soft); padding:6px 0 14px; display:none; max-width:640px; }
  .letra-box.open{ display:block; }

  .historia-resumo{ font-size:14px; color:var(--ink-soft); line-height:1.65; margin-bottom:24px; max-width:640px; }
  .historia-tag{
    display:inline-block; font-size:11px; color:var(--gold); background:var(--gold-soft);
    padding:4px 11px; border-radius:20px; margin-bottom:16px; font-weight:600;
  }
  .timeline{ position:relative; padding-left:20px; margin-bottom:30px; max-width:640px; }
  .timeline::before{
    content:""; position:absolute; left:4px; top:4px; bottom:4px; width:1px; background:var(--line);
  }
  .timeline-item{ position:relative; padding-bottom:18px; }
  .timeline-item::before{
    content:""; position:absolute; left:-20px; top:3px; width:9px; height:9px; border-radius:50%;
    background:var(--terra); border:2px solid var(--bg);
  }
  .timeline-year{ font-size:11.5px; color:var(--gold); font-weight:600; margin-bottom:3px; }
  .timeline-text{ font-size:13.5px; line-height:1.55; }

  @media (max-width:640px){
    .site-nav{ padding:16px; }
    .nav-links{ gap:18px; }
    .site-main{ padding:0 16px 60px; }
    .view{ padding-top:24px; }
    .home-hero{ flex-direction:column; }
    .stat-row{ flex-direction:row; }
  }
</style>
</head>
<body>

<nav class="site-nav hidden" id="site-nav">
  <div class="brand"><span class="mark"></span>Raízes</div>
  <div class="nav-links">
    <a href="../index.html" class="nav-link" style="text-decoration:none;">‹ Site</a>
    <button class="nav-link active" data-view="home" onclick="showView('home')">Início</button>
    <button class="nav-link" data-view="biblioteca" onclick="showView('biblioteca')">Guias</button>
    <button class="nav-link" data-view="historia" onclick="showView('historia')">História</button>
