</main>

<script>
  const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

  const DIAS_SEMANA = ["Domingo","Segunda-feira","Terça-feira","Quarta-feira","Quinta-feira","Sexta-feira","Sábado"];

  /* ==========================================================
     ESTADO
     ========================================================== */
  const appState = {
    user: null,               // sessão do Supabase Auth
    guias: [],                // todos os guias, carregados uma vez
    conteudos: [],             // todos os conteúdos, carregados uma vez
    culturas: [],               // culturas afro-diaspóricas (tabela "culturas")
    migracoes: [],               // rotas de migração/transmissão entre continentes
    culturaAberta: null,        // slug da cultura em detalhe, ou null
    historiaModo: "lista",        // lista | mapa
    historiaContinente: "todos",  // filtro de continente na lista
    bibliotecaTradicao: "umbanda", // tradição ativa — ajustada pra primeira que existir, ao carregar
    bibliotecaCategoria: "orixas", // orixas | entidades | pontos | riscados | itans
    bibliotecaGuiaAberto: null, // slug do guia em detalhe, ou null pra lista geral
    bibliotecaRiscadoAberto: null, // slug do guia com o ponto riscado em detalhe
    isPlaying: false,
    currentTrackId: null,
  };

  // Rótulos amigáveis por tradição — cai num padrão genérico quando a
  // tradição não está na lista (assim novas tradições já funcionam
  // sem precisar mexer no código, só ficam com nome genérico até
  // alguém vir aqui e dar um nome mais preciso).
  const TRADICAO_NOME = { umbanda: "Umbanda", candomble: "Candomblé", vodum: "Vodum", santeria: "Santería", jurema: "Jurema Sagrada", quimbanda: "Quimbanda" };
  const TRADICAO_LABELS = {
    umbanda: { principal: "Orixás", auxiliar: "Entidades" },
    candomble: { principal: "Orixás", auxiliar: "Entidades" },
    vodum: { principal: "Lwa", auxiliar: "Outras entidades" },
    santeria: { principal: "Orishas", auxiliar: "Otras entidades" },
  };
  function labelGrupo(tradicao, grupo) {
    const labels = TRADICAO_LABELS[tradicao] || { principal: "Guias principais", auxiliar: "Outras entidades" };
    return labels[grupo] || labels.principal;
  }

  /* ==========================================================
     NAVEGAÇÃO ENTRE TELAS
     ========================================================== */
  function showView(name) {
    document.querySelectorAll(".view").forEach(v => v.classList.remove("active"));
    document.getElementById("view-" + name).classList.add("active");
    const navLink = document.querySelector('.nav-link[data-view="' + name + '"]');
    if (navLink) {
      document.querySelectorAll(".nav-link").forEach(l => l.classList.remove("active"));
      navLink.classList.add("active");
    }
    document.getElementById("site-nav").classList.toggle("hidden", name === "login");
    window.scrollTo({ top: 0, behavior: "auto" });
  }

  /* ==========================================================
     AUTENTICAÇÃO
     ========================================================== */
  async function onSignInWithGoogle() {
    const errorEl = document.getElementById("login-error");
    errorEl.textContent = "";
    const { error } = await supabaseClient.auth.signInWithOAuth({
      provider: "google",
      options: { redirectTo: window.location.href },
    });
    if (error) errorEl.textContent = "Não deu pra entrar agora — tenta de novo em instantes.";
  }

  async function onSignOut() {
    await supabaseClient.auth.signOut();
    appState.user = null;
    showView("login");
  }

  async function checkSession() {
    const { data: { session } } = await supabaseClient.auth.getSession();
    if (session) {
      appState.user = session.user;
      await onAuthReady();
    } else {
      showView("login");
    }
    // Mantém a UI em sincronia caso o login termine em outra aba/redirect
    supabaseClient.auth.onAuthStateChange(async (event, session) => {
      if (event === "SIGNED_IN" && session) {
        appState.user = session.user;
        await onAuthReady();
      } else if (event === "SIGNED_OUT") {
        appState.user = null;
        showView("login");
      }
    });
  }

  async function onAuthReady() {
    await Promise.all([loadCatalogo(), loadHomeData(), loadPerfilData()]);
    renderTradicaoChips();
    atualizarLabelsAbas();
    renderBibliotecaList();
    renderHistoriaList();
    showView("home");
  }

  /* ==========================================================
     CATÁLOGO (guias + conteúdos + culturas) — carregado uma vez,
     é dado público, não muda por usuário.
     ========================================================== */
  async function loadCatalogo() {
    const [{ data: guias, error: errGuias }, { data: conteudos, error: errConteudos }, { data: culturas, error: errCulturas }, { data: migracoes, error: errMigracoes }] = await Promise.all([
      supabaseClient.from("guias").select("*").eq("ativo", true).order("ordem"),
      supabaseClient.from("conteudos").select("*").eq("ativo", true).order("ordem"),
      supabaseClient.from("culturas").select("*").eq("ativo", true).order("ordem"),
      supabaseClient.from("culturas_migracoes").select("*").eq("ativo", true).order("ordem"),
    ]);
    if (errGuias) console.error("Erro ao carregar guias:", errGuias);
    if (errConteudos) console.error("Erro ao carregar conteúdos:", errConteudos);
    if (errCulturas) console.error("Erro ao carregar culturas:", errCulturas);
    if (errMigracoes) console.error("Erro ao carregar migrações:", errMigracoes);
    appState.guias = guias || [];
    appState.conteudos = conteudos || [];
    appState.culturas = culturas || [];
    appState.migracoes = migracoes || [];
  }

  /* ==========================================================
     HISTÓRIA — raízes afro-diaspóricas
     ========================================================== */
  const CONTINENTE_NOME = {
    "america-norte": "América do Norte",
    "america-central-caribe": "América Central e Caribe",
    "america-sul": "América do Sul",
    "europa": "Europa",
    "africa": "África",
    "oriente-medio": "Oriente Médio",
    "siberia": "Sibéria",
    "asia": "Ásia",
    "oceania": "Oceania",
  };

  // posições fixas das 9 regiões no mapa esquemático (viewBox 680x460)
  const MAPA_ZONAS = {
    "america-norte":          { nome: "América do Norte",          x: 40,  y: 60,  w: 150, h: 110 },
    "america-central-caribe": { nome: "América Central e Caribe",  x: 40,  y: 190, w: 150, h: 100 },
    "america-sul":            { nome: "América do Sul",            x: 40,  y: 310, w: 150, h: 110 },
    "europa":                 { nome: "Europa",                    x: 270, y: 60,  w: 150, h: 110 },
    "africa":                 { nome: "África",                    x: 270, y: 190, w: 150, h: 130 },
    "oriente-medio":          { nome: "Oriente Médio",             x: 270, y: 340, w: 150, h: 80  },
    "siberia":                { nome: "Sibéria",                   x: 470, y: 60,  w: 150, h: 100 },
    "asia":                   { nome: "Ásia",                      x: 470, y: 180, w: 150, h: 110 },
    "oceania":                { nome: "Oceania",                   x: 470, y: 310, w: 150, h: 100 },
  };

  function setHistoriaModo(modo) {
    appState.historiaModo = modo;
    document.getElementById("historia-modo-lista").classList.toggle("active", modo === "lista");
    document.getElementById("historia-modo-mapa").classList.toggle("active", modo === "mapa");
    document.getElementById("historia-list-wrap").style.display = modo === "lista" ? "block" : "none";
    document.getElementById("historia-mapa-wrap").style.display = modo === "mapa" ? "block" : "none";
    if (modo === "mapa") renderMapaMundial();
  }

  function setHistoriaContinente(continente) {
    appState.historiaContinente = continente;
    document.querySelectorAll("#historia-continente-filters .filter").forEach(f => {
      f.classList.toggle("active", f.dataset.cont === continente);
    });
    renderHistoriaList();
  }

  function renderHistoriaContinenteFilters() {
    const presentes = [...new Set(appState.culturas.map(c => c.continente).filter(Boolean))];
    const container = document.getElementById("historia-continente-filters");
    const chips = [`<div class="filter${appState.historiaContinente === "todos" ? " active" : ""}" data-cont="todos" onclick="setHistoriaContinente('todos')">Todos</div>`]
      .concat(presentes.map(cont => `<div class="filter${appState.historiaContinente === cont ? " active" : ""}" data-cont="${cont}" onclick="setHistoriaContinente('${cont}')">${CONTINENTE_NOME[cont] || cont}</div>`));
    container.innerHTML = chips.join("");
  }

  function renderHistoriaList() {
    renderHistoriaContinenteFilters();
    const container = document.getElementById("historia-list");
    const culturas = appState.historiaContinente === "todos"
      ? appState.culturas
      : appState.culturas.filter(c => c.continente === appState.historiaContinente);
    if (!culturas.length) {
      container.innerHTML = `<p class="empty-note">Nenhuma cultura cadastrada ainda.</p>`;
      return;
    }
    container.innerHTML = culturas.map(c => `
      <div class="list-item" onclick="onOpenCultura('${c.slug}')">
        <div class="dot">${escapeHtml(c.nome.charAt(0))}</div>
        <div class="meta">
          <p class="title">${escapeHtml(c.nome)}</p>
          <p class="sub">${escapeHtml(c.regiao_origem || "")}</p>
        </div>
        <span class="chev">›</span>
      </div>`).join("");
  }

  function renderMapaMundial() {
    const container = document.getElementById("historia-mapa");
    const boxesHtml = Object.entries(MAPA_ZONAS).map(([cont, zona]) => {
      const count = appState.culturas.filter(c => c.continente === cont).length;
      const cx = zona.x + zona.w / 2;
      return `
        <g class="node" onclick="onAbrirZonaMapa('${cont}')" style="cursor:pointer;">
          <rect x="${zona.x}" y="${zona.y}" width="${zona.w}" height="${zona.h}" rx="10"
                fill="var(--card)" stroke="var(--line)" stroke-width="1" stroke-dasharray="4 3"/>
          <text x="${zona.x + 12}" y="${zona.y + 24}" font-family="Fraunces, serif" font-size="14" fill="var(--ink)">${escapeHtml(zona.nome)}</text>
          <text x="${zona.x + 12}" y="${zona.y + 44}" font-family="Inter, sans-serif" font-size="11.5" fill="var(--ink-soft)">${count} cultura${count === 1 ? "" : "s"} cadastrada${count === 1 ? "" : "s"}</text>
        </g>`;
    }).join("");

    const arrowsHtml = appState.migracoes.map(m => {
      const de = MAPA_ZONAS[m.continente_origem];
      const para = MAPA_ZONAS[m.continente_destino];
      if (!de || !para) return "";
      const x1 = de.x + de.w / 2, y1 = de.y + de.h / 2;
      const x2 = para.x + para.w / 2, y2 = para.y + para.h / 2;
      const mx = (x1 + x2) / 2, my = (y1 + y2) / 2 - 40;
      return `<path d="M${x1},${y1} Q${mx},${my} ${x2},${y2}" fill="none" stroke="var(--gold)" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.6" marker-end="url(#seta-migracao)"/>`;
    }).join("");

    container.innerHTML = `
      <svg width="100%" viewBox="0 0 680 460" role="img" style="overflow:visible;">
        <title>Mapa de povos originários</title>
        <defs>
          <marker id="seta-migracao" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M2 1L8 5L2 9" fill="none" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </marker>
        </defs>
        ${arrowsHtml}
        ${boxesHtml}
      </svg>`;
  }

  function onAbrirZonaMapa(continente) {
    setHistoriaModo("lista");
    setHistoriaContinente(continente);
  }

  function onOpenCultura(slug) {
    appState.culturaAberta = slug;
    renderCulturaDetalhe(slug);
    showView("cultura-detalhe");
  }

  function renderCulturaDetalhe(slug) {
    const cultura = appState.culturas.find(c => c.slug === slug);
    if (!cultura) return;

    document.getElementById("cultura-regiao").textContent = cultura.regiao_origem || "";
    document.getElementById("cultura-nome").textContent = cultura.nome;
    document.getElementById("cultura-resumo").textContent = cultura.resumo || "";

    const marcos = Array.isArray(cultura.marcos) ? cultura.marcos : [];
    document.getElementById("cultura-timeline").innerHTML = marcos.map(m => `
      <div class="timeline-item">
        <p class="timeline-year">${escapeHtml(m.ano || "")}</p>
        <p class="timeline-text">${escapeHtml(m.texto || "")}</p>
      </div>`).join("") || `<p class="empty-note">Sem marcos cadastrados ainda.</p>`;

    const guiasRelacionados = appState.guias.filter(g => g.origem_cultural_id === cultura.id);
    const guiasContainer = document.getElementById("cultura-guias-relacionados");
    guiasContainer.innerHTML = guiasRelacionados.length
      ? guiasRelacionados.map(g => `
        <div class="list-item" onclick="onOpenGuia('${g.slug}')">
          <div class="dot">${escapeHtml(g.nome.charAt(0))}</div>
          <div class="meta"><p class="title">${escapeHtml(g.nome)}</p><p class="sub">${TRADICAO_NOME[g.tradicao] || g.tradicao}</p></div>
          <span class="chev">›</span>
        </div>`).join("")
      : `<p class="empty-note">Nenhum guia catalogado ainda para esta tradição.</p>`;
  }

  /* ==========================================================
     HOME
     ========================================================== */
  async function loadHomeData() {
    const nome = (appState.user.user_metadata && appState.user.user_metadata.full_name)
      ? appState.user.user_metadata.full_name.split(" ")[0]
      : appState.user.email;
    document.getElementById("user-name").textContent = nome;

    const { data: guiaDoDia, error: errGuiaDoDia } = await supabaseClient
      .from("guia_do_dia_hoje").select("*").maybeSingle();
    if (errGuiaDoDia) console.error("Erro ao carregar guia do dia:", errGuiaDoDia);
    if (guiaDoDia) {
      const diaLabel = DIAS_SEMANA[new Date().getDay()];
      document.getElementById("guia-do-dia-nome").textContent = guiaDoDia.nome;
      document.getElementById("guia-do-dia-info").textContent =
        diaLabel + (guiaDoDia.linha ? " · " + guiaDoDia.linha : "");
    } else {
      document.getElementById("guia-do-dia-nome").textContent = "—";
      document.getElementById("guia-do-dia-info").textContent = "Nenhum guia definido pra hoje ainda";
    }

    const { data: streak } = await supabaseClient.rpc("get_streak", { p_user_id: appState.user.id });
    const { data: ouvidos } = await supabaseClient.rpc("get_total_ouvidos", { p_user_id: appState.user.id });
    document.getElementById("stat-streak").textContent = streak ?? 0;
    document.getElementById("stat-ouvidos").textContent = ouvidos ?? 0;

    // Sugestão de hoje: os conteúdos mais recentes do catálogo.
    // Critério simples por enquanto — dá pra refinar depois (ex:
    // priorizar conteúdo do guia do dia, ou o que o usuário ainda
    // não ouviu).
    const sugestoes = [...appState.conteudos]
      .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))
      .slice(0, 3);
    renderHomeSuggestions(sugestoes);
  }

  function renderHomeSuggestions(items) {
    const container = document.getElementById("home-suggestions");
    if (!items.length) {
      container.innerHTML = '<p class="empty-note">Nenhum conteúdo publicado ainda.</p>';
      return;
    }
    container.innerHTML = items.map(item => `
      <div class="list-item" onclick="onOpenTrack('${item.id}')">
        <div class="dot">${dotConteudo(item)}</div>
        <div class="meta">
          <p class="title">${escapeHtml(item.titulo)}</p>
          <p class="sub">${subConteudo(item)}</p>
        </div>
        <span class="chev">›</span>
      </div>
    `).join("");
  }

  function onOpenNotifications() {
    // Sem central de notificações ainda — sem TODO pendente de dado,
    // é só uma tela que ainda não foi desenhada.
  }

  /* ==========================================================
     BIBLIOTECA
     ========================================================== */
  function setBibliotecaTradicao(tradicao) {
    appState.bibliotecaTradicao = tradicao;
    appState.bibliotecaGuiaAberto = null;
    appState.bibliotecaRiscadoAberto = null;
    renderTradicaoChips();
    atualizarLabelsAbas();
    renderBibliotecaList();
  }

  function renderTradicaoChips() {
    const container = document.getElementById("tradicao-filters");
    const tradicoes = [...new Set(appState.guias.map(g => g.tradicao || "umbanda"))].sort();
    if (!tradicoes.includes(appState.bibliotecaTradicao)) {
      appState.bibliotecaTradicao = tradicoes[0] || "umbanda";
    }
    container.innerHTML = tradicoes.map(t => `
      <div class="filter ${t === appState.bibliotecaTradicao ? "active" : ""}" onclick="setBibliotecaTradicao('${t}')">
        ${escapeHtml(TRADICAO_NOME[t] || (t.charAt(0).toUpperCase() + t.slice(1)))}
      </div>
    `).join("");
  }

  function atualizarLabelsAbas() {
    const t = appState.bibliotecaTradicao;
    document.querySelector('#biblioteca-filters .filter[data-cat="orixas"]').textContent = labelGrupo(t, "principal");
    document.querySelector('#biblioteca-filters .filter[data-cat="entidades"]').textContent = labelGrupo(t, "auxiliar");
  }

  function setBibliotecaCategoria(cat, el) {
    document.querySelectorAll("#biblioteca-filters .filter").forEach(f => f.classList.remove("active"));
    el.classList.add("active");
    appState.bibliotecaCategoria = cat;
    appState.bibliotecaGuiaAberto = null;
    appState.bibliotecaRiscadoAberto = null;
    renderBibliotecaList();
  }

  function contarConteudos(guiaId, tipo) {
    return appState.conteudos.filter(c => c.guia_id === guiaId && c.tipo === tipo).length;
  }

  // Guias da tradição ativa — usado como base por todos os modos da Biblioteca
  function guiasDaTradicao() {
    return appState.guias.filter(g => (g.tradicao || "umbanda") === appState.bibliotecaTradicao);
  }

  function renderBibliotecaList() {
    const container = document.getElementById("biblioteca-list");
    const idsDaTradicao = new Set(guiasDaTradicao().map(g => g.id));

    // Modo "detalhe de um guia": mostra os conteúdos dele, com botão de voltar embutido na lista
    if (appState.bibliotecaGuiaAberto) {
      const guia = appState.guias.find(g => g.slug === appState.bibliotecaGuiaAberto);
      const conteudos = appState.conteudos.filter(c => c.guia_id === guia.id);
      let html = `<div class="back-row" onclick="fecharDetalheGuia()">‹ Voltar</div>`;
      html += conteudos.length
        ? conteudos.map(item => `
            <div class="list-item" onclick="onOpenTrack('${item.id}')">
              <div class="dot">${dotConteudo(item)}</div>
              <div class="meta">
                <p class="title">${escapeHtml(item.titulo)}</p>
                <p class="sub">${subConteudo(item)}</p>
              </div>
              <span class="chev">›</span>
            </div>
          `).join("")
        : '<p class="empty-note">Ainda sem pontos, orações ou contos cadastrados pra esse guia.</p>';
      container.innerHTML = html;
      return;
    }

    // Modo "detalhe de um ponto riscado": mostra a imagem grande + atalho pro guia
    if (appState.bibliotecaRiscadoAberto) {
      const guia = appState.guias.find(g => g.slug === appState.bibliotecaRiscadoAberto);
      container.innerHTML = `
        <div class="back-row" onclick="fecharDetalheRiscado()">‹ Voltar</div>
        <img src="${guia.ponto_riscado_url}" style="width:100%; border-radius:16px; margin-bottom:16px;">
        <h3 style="margin-bottom:6px;">${escapeHtml(guia.nome)}</h3>
        <p style="font-size:13px; color:var(--ink-soft); line-height:1.5; margin-bottom:16px;">${escapeHtml(guia.descricao || "")}</p>
        <div class="signout-btn" onclick="onVerGuiaDoRiscado('${guia.slug}')">Ver pontos e orações de ${escapeHtml(guia.nome)}</div>
      `;
      return;
    }

    // Modo "Itans": lista plana de todos os contos/histórias, da tradição ativa
    if (appState.bibliotecaCategoria === "itans") {
      const itans = appState.conteudos.filter(c => c.tipo === "conto" && idsDaTradicao.has(c.guia_id));
      container.innerHTML = itans.length
        ? itans.map(item => {
            const guia = appState.guias.find(g => g.id === item.guia_id);
            return `
              <div class="list-item" onclick="onOpenTrack('${item.id}')">
                <div class="dot">${dotConteudo(item)}</div>
                <div class="meta">
                  <p class="title">${escapeHtml(item.titulo)}</p>
                  <p class="sub">${guia ? escapeHtml(guia.nome) : "Itã"}</p>
                </div>
                <span class="chev">›</span>
              </div>
            `;
          }).join("")
        : '<p class="empty-note">Nenhum Itã publicado ainda nessa tradição.</p>';
      return;
    }

    // Modo "Pontos Cantados": lista plana de todos os conteúdos tipo ponto, da tradição ativa
    if (appState.bibliotecaCategoria === "pontos") {
      const pontos = appState.conteudos.filter(c => c.tipo === "ponto" && idsDaTradicao.has(c.guia_id));
      container.innerHTML = pontos.length
        ? pontos.map(item => {
            const guia = appState.guias.find(g => g.id === item.guia_id);
            return `
              <div class="list-item" onclick="onOpenTrack('${item.id}')">
                <div class="dot">${dotConteudo(item)}</div>
                <div class="meta">
                  <p class="title">${escapeHtml(item.titulo)}</p>
                  <p class="sub">${guia ? escapeHtml(guia.nome) + " · " : ""}${formatDuracao(item.duracao_segundos)}</p>
                </div>
                <span class="chev">›</span>
              </div>
            `;
          }).join("")
        : '<p class="empty-note">Nenhum ponto cantado publicado ainda nessa tradição.</p>';
      return;
    }

    // Modo "Pontos Riscados": lista plana dos guias da tradição ativa que já têm imagem cadastrada
    if (appState.bibliotecaCategoria === "riscados") {
      const riscados = guiasDaTradicao().filter(g => g.ponto_riscado_url);
      container.innerHTML = riscados.length
        ? riscados.map(guia => `
            <div class="list-item" onclick="onOpenRiscado('${guia.slug}')">
              <div class="dot" style="padding:0; overflow:hidden;"><img src="${guia.ponto_riscado_url}" style="width:100%; height:100%; object-fit:cover;"></div>
              <div class="meta"><p class="title">${escapeHtml(guia.nome)}</p><p class="sub">${escapeHtml(guia.linha || "")}</p></div>
              <span class="chev">›</span>
            </div>
          `).join("")
        : '<p class="empty-note">Nenhum ponto riscado cadastrado ainda nessa tradição.</p>';
      return;
    }

    // Modo "Principais" / "Auxiliares" (Orixás/Entidades, Lwa/Outras, Orishas/Otras...): guias por grupo, dentro da tradição ativa
    const grupoDaAba = appState.bibliotecaCategoria === "orixas" ? "principal" : "auxiliar";
    const lista = guiasDaTradicao().filter(g => (g.grupo || "principal") === grupoDaAba);

    container.innerHTML = lista.length
      ? lista.map(guia => `
          <div class="list-item" onclick="onOpenGuia('${guia.slug}')">
            <div class="dot">${guia.nome.charAt(0)}</div>
            <div class="meta">
              <p class="title">${escapeHtml(guia.nome)}</p>
              <p class="sub">${guia.categoria ? escapeHtml(guia.categoria) + " · " : ""}${contarConteudos(guia.id, "ponto")} pontos · ${contarConteudos(guia.id, "oracao")} orações</p>
            </div>
            <span class="chev">›</span>
          </div>
        `).join("")
      : '<p class="empty-note">Nenhum guia nesse grupo ainda.</p>';
  }

  function onOpenGuia(slug) {
    appState.bibliotecaGuiaAberto = slug;
    renderBibliotecaList();
  }

  function fecharDetalheGuia() {
    appState.bibliotecaGuiaAberto = null;
    renderBibliotecaList();
  }

  function onOpenRiscado(slug) {
    appState.bibliotecaRiscadoAberto = slug;
    renderBibliotecaList();
  }

  function fecharDetalheRiscado() {
    appState.bibliotecaRiscadoAberto = null;
    renderBibliotecaList();
  }

  function onVerGuiaDoRiscado(slug) {
    appState.bibliotecaRiscadoAberto = null;
    appState.bibliotecaGuiaAberto = slug;
    renderBibliotecaList();
  }

  function onOpenSearch() {
    // Busca dentro da Biblioteca ainda não desenhada — quando entrar
    // no escopo, filtra appState.guias/appState.conteudos por texto,
    // sem precisar de chamada nova ao Supabase.
  }

  /* ==========================================================
     PLAYER
     ========================================================== */
  function onOpenTrack(conteudoId) {
    const item = appState.conteudos.find(c => c.id === conteudoId);
    if (!item) return;
    appState.currentTrackId = conteudoId;

    const guia = appState.guias.find(g => g.id === item.guia_id);
    document.getElementById("player-title").textContent = item.titulo;
    document.getElementById("player-sub").textContent = item.voz
      ? "Voz: " + item.voz
      : (guia ? guia.nome : "");

    const art = document.getElementById("player-art");
    if (item.imagem_url) {
      art.style.background = `url('${item.imagem_url}') center/cover`;
      art.innerHTML = "";
    } else {
      art.style.background = "";
      art.innerHTML = '<div class="ring"></div>';
    }

    const audio = document.getElementById("audio-player");
    const playBtn = document.getElementById("play-pause-btn");
    audio.pause();
    audio.currentTime = 0;

    const audioSection = document.getElementById("player-audio-section");
    if (item.audio_url) {
      audio.src = item.audio_url;
      playBtn.disabled = false;
      playBtn.style.opacity = 1;
      audioSection.style.display = "";
    } else {
      audio.removeAttribute("src");
      playBtn.disabled = true;
      playBtn.style.opacity = 0.4;
      audioSection.style.display = "none";
    }

    document.getElementById("player-time-total").textContent = formatDuracao(item.duracao_segundos);
    document.getElementById("player-time-current").textContent = "0:00";
    updateWaveformProgress(0);

    document.getElementById("lyric-toggle-label").textContent =
      item.tipo === "ponto" ? "Letra do ponto" : item.tipo === "conto" ? "Ler o conto" : "Ler a oração";
    const letraBox = document.getElementById("letra-box");
    letraBox.textContent = item.letra || "Texto ainda não cadastrado.";
    // Sem áudio, o texto é o próprio conteúdo — já abre expandido
    letraBox.classList.toggle("open", !item.audio_url);
    document.getElementById("lyric-chevron").textContent = item.audio_url ? "⌄" : "⌃";

    appState.isPlaying = false;
    playBtn.textContent = "▶";

    showView("player");
  }

  function onTogglePlay() {
    const audio = document.getElementById("audio-player");
    const btn = document.getElementById("play-pause-btn");
    if (!audio.src) return;
    if (audio.paused) {
      audio.play();
      appState.isPlaying = true;
      btn.textContent = "❚❚";
    } else {
      audio.pause();
      appState.isPlaying = false;
      btn.textContent = "▶";
    }
  }

  function onSkip(direction) {
    // Pular pra próxima/anterior faixa dentro da mesma lista (playlist
    // de sugestões ou de um guia) fica pra quando existir de fato uma
    // playlist ordenada em uso — hoje o player sempre abre a partir de
    // um item específico clicado, sem "fila" implícita.
  }

  function onToggleLyrics() {
    const box = document.getElementById("letra-box");
    const chevron = document.getElementById("lyric-chevron");
    box.classList.toggle("open");
    chevron.textContent = box.classList.contains("open") ? "⌃" : "⌄";
  }

  function updateWaveformProgress(percentPlayed) {
    const bars = document.querySelectorAll("#player-waveform .bar");
    const total = bars.length;
    const played = Math.round((percentPlayed / 100) * total);
    bars.forEach((bar, i) => bar.classList.toggle("played", i < played));
  }

  function updatePlayerTime(currentSeconds, totalSeconds) {
    document.getElementById("player-time-current").textContent = formatDuracao(currentSeconds);
    if (totalSeconds) {
      document.getElementById("player-time-total").textContent = formatDuracao(totalSeconds);
    }
  }

  document.getElementById("audio-player").addEventListener("timeupdate", (e) => {
    const audio = e.target;
    if (!audio.duration) return;
    updatePlayerTime(Math.floor(audio.currentTime), Math.floor(audio.duration));
    updateWaveformProgress((audio.currentTime / audio.duration) * 100);
  });

  document.getElementById("audio-player").addEventListener("ended", () => {
    appState.isPlaying = false;
    document.getElementById("play-pause-btn").textContent = "▶";
    if (appState.currentTrackId) markTrackAsCompleted(appState.currentTrackId);
  });

  /* ==========================================================
     STREAK / LOG DE ESCUTA
     ========================================================== */
  async function markTrackAsCompleted(conteudoId) {
    const { error } = await supabaseClient.from("escutas").insert({
      user_id: appState.user.id,
      conteudo_id: conteudoId,
    });
    if (error) {
      console.error("Erro ao registrar escuta:", error);
      return;
    }
    // Recalcula os números da Home e do Perfil pra refletir a escuta nova
    await Promise.all([loadHomeData(), loadPerfilData()]);
  }

  /* ==========================================================
     PERFIL
     ========================================================== */
  async function loadPerfilData() {
    const meta = appState.user.user_metadata || {};
    const nome = meta.full_name || appState.user.email;
    document.getElementById("perfil-nome").textContent = nome;
    document.getElementById("perfil-email").textContent = appState.user.email;
    document.getElementById("perfil-inicial").textContent = nome.charAt(0).toUpperCase();

    const { data: streak } = await supabaseClient.rpc("get_streak", { p_user_id: appState.user.id });
    const { data: ouvidos } = await supabaseClient.rpc("get_total_ouvidos", { p_user_id: appState.user.id });
    document.getElementById("perfil-streak").textContent = streak ?? 0;
    document.getElementById("perfil-ouvidos").textContent = ouvidos ?? 0;
  }

  /* ==========================================================
     HELPERS
     ========================================================== */
  function formatDuracao(segundos) {
    if (!segundos && segundos !== 0) return "—";
    const m = Math.floor(segundos / 60);
    const s = Math.floor(segundos % 60).toString().padStart(2, "0");
    return `${m}:${s}`;
  }

  function iconeConteudo(tipo) {
    return tipo === "ponto" ? "▶" : tipo === "conto" ? "📖" : "≡";
  }
  function dotConteudo(item) {
    return item.imagem_url
      ? `<img src="${item.imagem_url}" style="width:100%; height:100%; object-fit:cover;">`
      : iconeConteudo(item.tipo);
  }
  function subConteudo(item) {
    if (item.tipo === "ponto") return formatDuracao(item.duracao_segundos) + " · áudio";
    if (item.tipo === "conto") return "Conto/história";
    return "Leitura";
  }

  function escapeHtml(str) {
    const div = document.createElement("div");
    div.textContent = str ?? "";
    return div.innerHTML;
  }

  /* ==========================================================
     INICIALIZAÇÃO
     ========================================================== */
  document.addEventListener("DOMContentLoaded", () => {
    checkSession();
  });
</script>

</body>
</html>
